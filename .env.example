# Web app settings
PORT=3000
OFF_USER_AGENT=NutriSearch/1.0 (your project contact)

# Required for account signup and login
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nutriscan
# Generate a private random value of at least 32 characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# OAuth 2.0 Web client ID from Google Cloud Console (leave blank to hide Google sign-in)
GOOGLE_CLIENT_ID=
